{
  "name": "@hoist-wen/dsh-trajectory-tool-insight",
  "version": "0.3.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "在「轨迹」旁新增「解读」标签页：对每一轮轨迹的工具调用一键解读，默认沿用当前会话正在使用的模型。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "trajectory",
    "tool-call",
    "interpretation"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  }
}
